- language = footprint.language
= link_to(school_language_path(language), class: 'footprint-card', data: { slug: language.slug, name: language.name.downcase, endonym: footprint.endonym.to_s.downcase, size: footprint.english_learners }) do
  %svg.footprint-map{ viewBox: viewbox, aria: { hidden: 'true' } }
    %use{ href: '#footprint-outline' }
    %g.footprint-dots
      - footprint.dots.each do |dot|
        %circle{ cx: dot.x, cy: dot.y, r: dot.r }
  - if footprint.endonym
    %span.footprint-endonym{ lang: footprint.lang, dir: 'auto' }= footprint.endonym
  %span.footprint-name= language.name
  %span.footprint-count
    = number_with_delimiter(footprint.english_learners)
    - unless footprint.year == latest_year
      = "in #{SchoolLanguage.school_year(footprint.year)}"
