%main.school-languages.language-browse
  %h2.mb-3 Los Angeles Area Languages
  %p.browse-intro
    Each map shows where English learners who speak a language went to school in
    = succeed('.') { SchoolLanguage.school_year(@latest_year) }
    Pick one to see its full map and how it has changed since 2011.
  .browse-controls
    %input.form-control#language-search{ type: 'search', placeholder: 'Find a language', aria: { label: 'Find a language' } }
    .btn-group{ role: 'group', aria: { label: 'Sort languages' } }
      %button.btn.btn-sm.btn-outline-secondary.active{ type: 'button', data: { sort: 'name' }, aria: { pressed: 'true' } } A–Z
      %button.btn.btn-sm.btn-outline-secondary{ type: 'button', data: { sort: 'size' }, aria: { pressed: 'false' } } Largest
  %p.browse-empty#language-search-empty{ hidden: true } No language matches.
  - cache ['language-browse', SchoolLanguageCount.count, SchoolLanguageCount.maximum(:id), File.mtime(Rails.root.join('config/school_language_endonyms.yml')).to_i] do
    - footprints = LanguageFootprint.all
    - larger, smaller = footprints.partition { _1.year == @latest_year && _1.english_learners >= SchoolLanguagesController::BROWSE_MINIMUM }
    %svg.footprint-defs{ aria: { hidden: 'true' }, width: 0, height: 0 }
      %symbol#footprint-base{ viewBox: "0 0 #{LanguageFootprint::WIDTH} #{LanguageFootprint::HEIGHT}" }
        - LanguageFootprint.base_dots.each do |dot|
          %circle{ cx: dot.x, cy: dot.y, r: dot.r }
    .footprint-grid
      = render partial: 'footprint', collection: larger
    - if smaller.any?
      %details.smaller-languages#smaller-languages
        %summary= "#{pluralize(smaller.size, 'smaller language')} (fewer than #{SchoolLanguagesController::BROWSE_MINIMUM} English learners)"
        .footprint-grid
          = render partial: 'footprint', collection: smaller
