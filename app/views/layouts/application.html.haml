!!!
%html
  %head
    %title Ethnic LA
    = csrf_meta_tags
    = stylesheet_link_tag    'application', 'https://fonts.googleapis.com/css?family=Passion+One', media: 'all', 'data-turbolinks-track': 'reload'
    = javascript_include_tag 'application', 'data-turbolinks-track': 'reload'
    = javascript_include_tag 'ethnic_churches_form', 'data-turbolinks-track': 'reload'
    = javascript_include_tag 'https://api.tiles.mapbox.com/mapbox-gl-js/v0.48.0/mapbox-gl.js'
    = stylesheet_link_tag    'https://api.tiles.mapbox.com/mapbox-gl-js/v0.48.0/mapbox-gl.css'
  %body
    %nav.navbar.navbar-expand.site-nav
      .container-fluid.justify-content-center
        %ul.navbar-nav
          %li.nav-item.dropdown
            %a.nav-link.dropdown-toggle#nav-religions{ href: '#', role: 'button', data: { bs_toggle: 'dropdown' }, aria: { expanded: 'false' } }
              - if current_religion_label
                Religion:
                %strong= current_religion_label
              - else
                Religion
            %ul.dropdown-menu{ aria: { labelledby: 'nav-religions' } }
              %li
                = link_to(root_path, class: ['dropdown-item', ('active' if viewing_ethnic_churches?)], id: 'nav-christianity', aria: { current: ('page' if viewing_ethnic_churches?) }) do
                  Christianity
                  %span.menu-subtitle (ethnic churches)
              %li
                %hr.dropdown-divider
              - menu_religions.each do |religion|
                - current = religion == @religion
                %li
                  = link_to(religion_path(religion), class: ['dropdown-item', ('active' if current)], aria: { current: ('page' if current) }) do
                    = religion.name
                    - if religion.admin_only
                      %span.admin-only-label (admins only)
              %li
                %hr.dropdown-divider
              %li= link_to('All religions', religions_path, class: ['dropdown-item', ('active' if controller_name == 'religions' && action_name == 'index')])
          %li.nav-item
            = link_to('Language Map', school_languages_path, id: 'nav-language-map', class: ['nav-link', ('active' if viewing_language_map?)], aria: { current: ('page' if viewing_language_map?) })
    = link_to(root_path, class: 'logo-text') do
      %header
        = image_tag 'koreanbell.png', size: '300x164', class: 'logo-image'
        %p.logo Ethnic LA
        %p.subtitle
          %strong
            = 'Facilitating the discovery of languages, cultures'
            %br
            = 'and ethnic groups in the Los Angeles area'
    .row.justify-content-center
      .col-9
        - if notice
          %p#notice.alert.alert-success
            = notice
        - if alert
          %p#alert.alert.alert-danger
            = alert
    = yield
    - if show_footer?
      %footer
        - if admin_signed_in?
          = link_to('Logout', destroy_admin_session_path, id: 'logout', method: :delete)
        - else
          = link_to('Admin Login', new_admin_session_path, id: 'login')
        = ' - '
        = link_to('Attributions', attributions_path)
        = ' - '
        = link_to('Source Code', 'https://github.com/ericmathison/ethnic_la')
